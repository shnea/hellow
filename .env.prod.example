# Copy to .env.prod on the production host, then replace every CHANGE_ME.
# Keep plaintext and private age keys out of Git. Do not reuse .env.dev secrets.
HELLOW_IMAGE_TAG=CHANGE_ME_VERIFIED_COMMIT_SHA
DB_NAME=hellow
DB_USER=hellow
DB_PASSWORD=CHANGE_ME_RANDOM_PRODUCTION_PASSWORD

PLATFORM_API_URL=https://platform.shnea.kr
PLATFORM_API_KEY=CHANGE_ME_PRODUCTION_PROJECT_KEY
PLATFORM_PROJECT_ID=CHANGE_ME_PRODUCTION_PROJECT_ID
PLATFORM_ENVIRONMENT_ID=CHANGE_ME_PRODUCTION_ENVIRONMENT_ID
PLATFORM_OIDC_ISSUER=CHANGE_ME_PRODUCTION_OIDC_ISSUER
PLATFORM_OIDC_CLIENT_ID=app
PLATFORM_OIDC_REDIRECT_URI=https://hellow.shnea.kr/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://hellow.shnea.kr/
HELLOW_ATTACHMENT_RETENTION_CODE=CHANGE_ME_APPROVED_RETENTION_CODE

# Verified issuer/subject for first platform-administrator access.
ADMIN_OIDC_ISSUER=CHANGE_ME_ADMIN_ISSUER
ADMIN_OIDC_SUB=CHANGE_ME_ADMIN_SUBJECT
# Leave empty unless the issuer issues a dedicated API audience.
HELLOW_API_AUDIENCE=

LIVEKIT_INTERNAL_URL=http://livekit:7880
LIVEKIT_URL=wss://hellow.shnea.kr/livekit
LIVEKIT_API_KEY=CHANGE_ME_RANDOM_PRODUCTION_KEY
LIVEKIT_API_SECRET=CHANGE_ME_RANDOM_PRODUCTION_SECRET
HELLOW_RECORDING_ENABLED=true
HELLOW_ROUTING_ENABLED=true
HELLOW_SUPPORT_CLEANUP_ENABLED=true
HELLOW_MEDIA_CLEANUP_ENABLED=true
HELLOW_WORK_TRANSFER_ENABLED=true
HELLOW_PUBLIC_PENDING_LIMIT=100
